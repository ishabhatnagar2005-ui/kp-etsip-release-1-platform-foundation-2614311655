# Mongo connection and database name
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=etsip
# Replace these illustrative values with unique secrets before use.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_PASSWORD=replace-with-a-unique-admin-password
DEMO_PASSWORD=replace-with-a-unique-demo-password
# Comma-separated browser origins
CORS_ORIGINS=http://localhost:5173
SEED_ON_STARTUP=true
